{
  "name": "dsh-agent-notify",
  "version": "0.2.0",
  "description": "DSH plugin: real Windows notifications (WinRT toast) when the agent finishes a run, needs approval, or asks you a question. · DSH 插件：任务完成 / 等待授权 / 等待选择时发真正的 Windows 系统通知。",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ssupervipuser/dsh-agent-notify.git"
  },
  "homepage": "https://github.com/Ssupervipuser/dsh-agent-notify#readme",
  "bugs": {
    "url": "https://github.com/Ssupervipuser/dsh-agent-notify/issues"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "notification",
    "notifications",
    "toast",
    "winrt",
    "windows"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node test/hardlink-safety.mjs",
    "test:manual": "node test/manual-test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "os": [
    "win32"
  ],
  "files": [
    "lib",
    "cordis.patch.yml",
    "screenshots.json",
    "README.md",
    "LICENSE"
  ]
}
